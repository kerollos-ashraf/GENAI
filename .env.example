# ---------- LLM (pick one provider; all have a free tier or run locally) ----------
# groq | openai | anthropic | ollama
LLM_PROVIDER=groq
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: LLM_TEMPERATURE=0 for more deterministic answers (leave unset for models that
# reject it, e.g. OpenAI reasoning models).
# Optional model override. Defaults: groq=openai/gpt-oss-120b (alternative: openai/gpt-oss-20b), openai=gpt-4o-mini, ollama=llama3.1
# LLM_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# For Ollama running on your host while the backend runs in Docker:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------- RAG ----------
# fastembed (local ONNX model, default) | hashing (no model download, offline)
# EMBEDDINGS_PROVIDER=fastembed
# RAG_TOP_K=3
# Seconds between checks of backend/data/policies for new/changed files (0 = off)
# KB_WATCH_INTERVAL=5
# Require `X-Admin-Token` for uploading/deleting knowledge-base documents (UI passes it too)
# ADMIN_TOKEN=

# ---------- Voice ----------
# Speech-to-text uses Groq Whisper with the same GROQ_API_KEY (free tier). Optional override:
# STT_MODEL=whisper-large-v3-turbo
